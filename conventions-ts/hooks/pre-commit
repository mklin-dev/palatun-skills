#!/bin/sh
# Contrôle de commit commun : ESLint et Prettier sur les fichiers indexés, sans rien réécrire
# (setup.md § Hooks git). Rapide, pas la barrière : `git commit --no-verify` le saute, la vérif
# d'avant PR rattrape.
# Le .githooks/pre-commit du dépôt le lance par exec ; ses réglages HOOK_PATHS, HOOK_EXTS et
# HOOK_FORMAT : setup.md § Hooks git. Les chemins des dépôts n'ont pas d'espace : une liste se
# découpe en mots.

hooks=$(cd "$(dirname "$0")" && pwd) || exit 1
cd "$(git rev-parse --show-toplevel)" || exit 1
# shellcheck source=env.sh
. "$hooks/env.sh"

set -f # sans glob : un dossier [slug] de Next est un nom, pas un motif
# quotePath : sans lui, git met entre guillemets un chemin accentué, que plus rien ne retrouve.
indexed() { git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR -- "$@"; }
exts=" ${HOOK_EXTS:-ts tsx mts cts js jsx mjs cjs} "
staged="" # tout fichier indexé, pour Prettier
for f in $(indexed); do
  [ -L "$f" ] || staged="$staged $f" # un lien : sa cible se vérifie là où elle vit
done
files="" # les fichiers d'ESLint
# shellcheck disable=SC2086 # HOOK_PATHS : une liste de mots
for f in $(indexed $HOOK_PATHS); do
  [ -L "$f" ] && continue
  case "${f##*/}" in *.*) ;; *) continue ;; esac
  case "$exts" in *" ${f##*.} "*) files="$files $f" ;; esac
done
case "${HOOK_FORMAT:-all}" in lint) format=$files ;; *) format=$staged ;; esac
[ -n "$files$format" ] || exit 0

# Sans dépendances, ce hook n'existe pas (il vit dans node_modules) : le .githooks du dépôt saute.
if ! command -v node >/dev/null 2>&1 || ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-commit : node ou pnpm absent, contrôles sautés (la vérif d'avant PR les fera)." >&2
  exit 0
fi
# Jamais d'installation depuis le hook : pnpm installerait avant d'exécuter un lockfile tiré sans
# `pnpm install` (verifyDepsBeforeRun), et le hook ne réécrit rien.
px() { pnpm --config.verify-deps-before-run=false exec "$@"; }
status=0

# ESLint tourne depuis le dossier de l'eslint.config le plus proche ; un fichier sans eslint.config
# au-dessus de lui n'est pas linté.
nearest_config() {
  dir=$(dirname "$1")
  while :; do
    for c in js mjs cjs ts mts cts; do [ -f "$dir/eslint.config.$c" ] && return 0; done
    [ "$dir" != . ] || return 1
    dir=$(dirname "$dir")
  done
}
pairs=$(for f in $files; do nearest_config "$f" && echo "$dir ${f#"$dir"/}"; done)
for d in $(printf '%s\n' "$pairs" | cut -d ' ' -f 1 | sort -u); do
  full=""
  for rel in $(printf '%s\n' "$pairs" | awk -v d="$d" '$1 == d { print $2 }'); do
    f=$rel
    [ "$d" = . ] || f="$d/$rel"
    if git diff --quiet -- "$f"; then
      full="$full $rel"
    # À moitié indexé : ESLint lit la version indexée par --stdin.
    elif ! git show ":$f" |
      (cd "$d" && px eslint --max-warnings 0 --no-warn-ignored --stdin --stdin-filename "$rel"); then
      echo "[eslint] $f (version indexée)"
      status=1
    fi
  done
  [ -n "$full" ] || continue
  # shellcheck disable=SC2086 # full : une liste de mots
  out=$(cd "$d" && px eslint --max-warnings 0 --no-warn-ignored $full 2>&1) || status=1
  [ -z "$out" ] || printf '%s\n' "$out"
done

# Prettier lit l'index : un fichier à moitié indexé se vérifie tel qu'il part dans le commit.
if [ -e node_modules/.bin/prettier ]; then
  full=""
  for f in $format; do
    if git diff --quiet -- "$f"; then
      full="$full $f"
    # --stdin-filepath respecte .prettierignore, mais renvoie alors le fichier sur stdout : jeté.
    elif ! git show ":$f" |
      px prettier --check --ignore-unknown --log-level warn --stdin-filepath "$f" >/dev/null; then
      echo "[warn] $f (version indexée)"
      status=1
    fi
  done
  # shellcheck disable=SC2086 # full : une liste de mots
  [ -z "$full" ] || px prettier --check --ignore-unknown --no-error-on-unmatched-pattern \
    --log-level warn $full || status=1
fi

[ "$status" -eq 0 ] && exit 0
echo "⛔ lint ou format en échec : corriger, ou git commit --no-verify."
exit 1
